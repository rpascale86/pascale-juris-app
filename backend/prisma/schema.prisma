generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// 🏢 TENANT: Advogado / Escritório Dono da Conta
// ------------------------------------------------------
model Lawyer {
  id            String      @id @default(uuid())
  name          String
  email         String      @unique
  password      String
  officeName    String?
  primaryColor  String      @default("#1e293b") // Padrão Enterprise
  
  clients       Client[]
  cases         Case[]
  leads         Lead[]
  documents     Document[]
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("lawyers")
}

// ------------------------------------------------------
// 👥 CLIENTES: Base Isolada por Tenant
// ------------------------------------------------------
model Client {
  id         String      @id @default(uuid())
  name       String
  email      String?
  cpfCnpj    String?     
  phone      String?
  
  cases      Case[]
  financials Financial[]
  
  lawyer     Lawyer      @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  lawyerId   String
  
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([lawyerId])
  @@map("clients")
}

// ------------------------------------------------------
// ⚖️ PROCESSOS: Core Business
// ------------------------------------------------------
model Case {
  id            String         @id @default(uuid())
  title         String
  processNumber String?
  value         Float?         @default(0)
  
  stage         String         @default("peticao")
  status        String         @default("Novo")
  anxietyScore  Int            @default(0)
  
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      String
  
  lawyer        Lawyer         @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  lawyerId      String
  
  timeline      CaseTimeline[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([clientId])
  @@index([lawyerId])
  @@map("cases")
}

// ------------------------------------------------------
// ⏳ TIMELINE: Histórico de Movimentações
// ------------------------------------------------------
model CaseTimeline {
  id          String   @id @default(uuid())
  title       String
  description String?
  date        String
  completed   Boolean  @default(false)
  isCurrent   Boolean  @default(false)
  
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId      String
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([caseId])
  @@map("case_timeline")
}

// ------------------------------------------------------
// 💰 FINANCEIRO: Contas a Receber
// ------------------------------------------------------
model Financial {
  id            String    @id @default(uuid())
  title         String
  amount        Float
  dueDate       String    
  paymentDate   DateTime? 
  type          String    
  status        String    @default("Aberto") 
  
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      String
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([clientId])
  @@map("financials")
}

// ------------------------------------------------------
// 🎯 LEADS: Funil de Conversão (Landing Page)
// ------------------------------------------------------
model Lead {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String
  type      String   
  status    String   @default("Novo") 
  
  lawyer    Lawyer   @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  lawyerId  String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lawyerId])
  @@map("leads")
}

// ------------------------------------------------------
// 📁 DOCUMENTOS: Referência do Supabase
// ------------------------------------------------------
model Document {
  id        String   @id @default(uuid())
  name      String
  client    String   // Campo desnormalizado para simplificação de MVP
  size      String   @default("0 MB")
  url       String?  
  
  lawyer    Lawyer   @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  lawyerId  String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lawyerId])
  @@map("documents")
}