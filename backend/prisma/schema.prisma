generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lawyer {
  id            String      @id @default(uuid())
  name          String
  email         String      @unique
  password      String
  officeName    String?
  primaryColor  String      @default("#4f46e5")
  
  // Relações SaaS (Isolamento total por Advogado)
  clients       Client[]
  cases         Case[]
  leads         Lead[]
  documents     Document[]
  
  createdAt     DateTime    @default(now())

  @@map("lawyers")
}

model Client {
  id         String      @id @default(uuid())
  name       String
  cpf        String?
  phone      String?
  
  cases      Case[]
  financials Financial[]
  
  // Vínculo Tenant
  lawyer     Lawyer      @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  lawyerId   String
  
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([lawyerId])
  @@map("clients")
}

model Case {
  id            String         @id @default(uuid())
  title         String
  processNumber String?
  notes         String?
  stage         String         @default("peticao")
  status        String         @default("Novo")
  anxietyScore  Int            @default(0)
  
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      String
  
  lawyer        Lawyer         @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  lawyerId      String
  
  timeline      CaseTimeline[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([clientId])
  @@index([lawyerId])
  @@map("cases")
}

model CaseTimeline {
  id          String   @id @default(uuid())
  title       String
  description String?
  date        String
  completed   Boolean  @default(false)
  
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId      String
  
  createdAt   DateTime @default(now())

  @@index([caseId])
  @@map("case_timeline")
}

model Financial {
  id        String   @id @default(uuid())
  title     String
  amount    Float
  dueDate   String
  type      String
  status    String   @default("Aberto")
  
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  
  createdAt DateTime @default(now())

  @@index([clientId])
  @@map("financials")
}

model Lead {
  id        String   @id @default(uuid())
  name      String
  phone     String
  type      String
  status    String   @default("Novo")
  date      String   @default("Hoje")
  
  lawyer    Lawyer   @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  lawyerId  String
  
  createdAt DateTime @default(now())

  @@index([lawyerId])
  @@map("leads")
}

model Document {
  id        String   @id @default(uuid())
  name      String
  client    String
  size      String   @default("1.5 MB")
  date      String   @default("Hoje")
  url       String?  
  
  lawyer    Lawyer   @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  lawyerId  String
  
  createdAt DateTime @default(now())

  @@index([lawyerId])
  @@map("documents")
}