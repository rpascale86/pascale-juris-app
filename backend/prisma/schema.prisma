// Configuração para Prisma + PostgreSQL
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- MODELOS DO SISTEMA OTIMIZADOS ---

model Lawyer {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String
  logoUrl       String?
  primaryColor  String    @default("#4f46e5")
  clients       Client[]
  cases         Case[]
  createdAt     DateTime  @default(now())

  // Boa prática: Força o nome da tabela em minúsculas e no plural no banco de dados real
  @@map("lawyers") 
}

model Client {
  id          String      @id @default(uuid())
  name        String
  
  // DADOS PESSOAIS COMPLETOS
  cpf         String?     @unique
  rg          String?
  phone       String
  email       String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  profession  String?
  civilState  String?

  // OTIMIZAÇÃO: Cascade delete - se apagar o advogado, apaga o cliente
  lawyer      Lawyer      @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  lawyerId    String
  cases       Case[]
  financials  Financial[]
  createdAt   DateTime    @default(now())

  // OTIMIZAÇÃO: Acelera absurdamente a busca por nome e CPF
  @@index([name]) 
  @@index([cpf])
  @@index([lawyerId]) 
  @@map("clients")
}

model Case {
  id            String         @id @default(uuid())
  title         String
  // NOVOS CAMPOS ADICIONADOS
  processNumber String?        // Opcional: Número CNJ do processo
  notes         String?
  status        String         @default("Em Andamento")
  stage         String         @default("peticao")
  anxietyScore  Int            @default(50)
  
  // OTIMIZAÇÃO: Cascade delete - se apagar o cliente, os processos dele também somem
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      String
  
  lawyer        Lawyer         @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  lawyerId      String
  timeline      TimelineStep[]
  updatedAt     DateTime       @updatedAt

  // OTIMIZAÇÃO: Acelera a listagem de processos ordenados pelo mais recente no Kanban
  @@index([updatedAt(sort: Desc)]) 
  @@index([clientId])
  @@map("cases")
}

model TimelineStep {
  id          String   @id @default(uuid())
  title       String
  description String
  date        String
  completed   Boolean  @default(false)
  isCurrent   Boolean  @default(false)
  
  // OTIMIZAÇÃO: Cascade delete - se apagar o processo, o histórico é limpo
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId      String

  @@index([caseId])
  @@map("timeline_steps")
}

model Financial {
  id        String   @id @default(uuid())
  title     String
  amount    Float
  dueDate   String
  status    String   @default("Aberto")
  type      String   @default("Boleto")
  
  // OTIMIZAÇÃO: Cascade delete - se apagar o cliente, as faturas pendentes também somem
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String

  // OTIMIZAÇÃO: Acelera a listagem de faturas que estão prestes a vencer
  @@index([dueDate(sort: Asc)]) 
  @@index([clientId])
  @@map("financials")
}